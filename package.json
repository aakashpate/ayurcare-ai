{
  "name": "ayurcare-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AyurCare AI - Multilingual AI-assisted patient case-taking platform for AYUSH healthcare",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "db:generate": "cd server && npx prisma generate",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npm run db:seed",
    "db:reset": "cd server && npx prisma migrate reset",
    "lint": "cd client && npm run lint",
    "typecheck": "cd client && npm run typecheck",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
